                }
              }
            }
          }
        }
      }
    },
    "/api/platform/session/antiforgery": {
      "get": {
        "tags": [
          "platform"
        ],
        "operationId": "GetPlatformSessionAntiforgery",
        "responses": {
          "204": {
            "description": "No Content"
          }
        }
      }
    },
    "/api/platform/session/login": {
      "post": {
        "tags": [
          "platform"
        ],
        "operationId": "LoginPlatformSession",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/platform/session/logout": {
      "post": {
        "tags": [
