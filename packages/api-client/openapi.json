            "description": "No Content"
          }
        }
      }
    },
    "/api/platform/session": {
      "get": {
        "tags": [
          "platform"
        ],
        "operationId": "GetPlatformSession",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/platform/session/organization/{organizationId}": {
      "post": {
        "tags": [
          "platform"
        ],
        "operationId": "SelectPlatformSessionOrganization",
        "parameters": [
          {
            "name": "organizationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          }
        }
      }
    },
    "/api/platform/staff": {
      "get": {
        "tags": [
          "platform"
        ],
        "operationId": "ListPlatformStaff",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/StaffMemberResponse"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/platform/staff/{membershipId}/roles": {
      "put": {
        "tags": [
          "platform"
        ],
        "operationId": "ChangePlatformStaffRoles",
        "parameters": [
          {
            "name": "membershipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangeStaffRolesRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "No Content"
          },
          "404": {
            "description": "Not Found"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/platform/staff/{membershipId}/suspend": {
      "post": {
        "tags": [
          "platform"
        ],
        "operationId": "SuspendPlatformStaff",
        "parameters": [
          {
            "name": "membershipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "404": {
            "description": "Not Found"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/platform/staff/{membershipId}/reactivate": {
      "post": {
        "tags": [
          "platform"
        ],
        "operationId": "ReactivatePlatformStaff",
        "parameters": [
          {
            "name": "membershipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "404": {
            "description": "Not Found"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/animals/species": {
      "get": {
        "tags": [
          "animals"
        ],
        "operationId": "ListAnimalsSpecies",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ReferenceItem"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/movements/intake-reasons": {
      "get": {
        "tags": [
          "movements"
        ],
        "operationId": "ListMovementsIntakeReasons",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ReferenceItem"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ChangeStaffRolesRequest": {
        "required": [
          "roles"
        ],
        "type": "object",
        "properties": {
          "roles": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string"
            }
          }
        }
      },
      "HttpValidationProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "LocalizedText": {
        "required": [
          "fr",
          "en"
        ],
        "type": "object",
        "properties": {
          "fr": {
            "type": "string",
            "description": "fr-CA text."
          },
          "en": {
            "type": "string",
            "description": "en-CA text."
          }
        },
        "description": "A value stored in both supported languages (ADR 0013). Both are required: reference data is always bilingual.\nClients pick the label by UI locale."
      },
      "LoginRequest": {
        "required": [
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "LoginResponse": {
        "required": [
          "status"
        ],
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          }
        }
      },
      "PingResponse": {
        "required": [
          "status"
        ],
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          }
        }
      },
      "ReferenceItem": {
        "required": [
          "code",
          "label"
        ],
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "Stable identifier stored by referencing rows; never shown to users."
          },
          "label": {
            "description": "Label in both languages.",
            "$ref": "#/components/schemas/LocalizedText"
          }
        },
        "description": "One value of a reference list as the API returns it: a stable code and both labels."
      },
      "SessionMembership": {
        "required": [
          "organizationId",
          "organizationName"
        ],
        "type": "object",
        "properties": {
          "organizationId": {
            "type": "string",
            "format": "uuid"
          },
          "organizationName": {
            "type": "string"
          }
        }
      },
      "SessionResponse": {
        "required": [
          "user",
          "memberships",
          "activeOrganizationId",
          "permissions"
        ],
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/SessionUser"
          },
          "memberships": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SessionMembership"
            }
          },
          "activeOrganizationId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "SessionUser": {
        "required": [
          "id",
          "displayName",
          "preferredLanguage",
          "isPlatformOperator",
          "mfaEnabled"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "displayName": {
            "type": "string"
          },
          "preferredLanguage": {
            "type": "string"
          },
          "isPlatformOperator": {
            "type": "boolean"
          },
          "mfaEnabled": {
            "type": "boolean"
          }
        }
      },
      "StaffMemberResponse": {
        "required": [
          "membershipId",
          "userId",
          "displayName",
          "email",
          "status",
          "roles"
        ],
        "type": "object",
        "properties": {
          "membershipId": {
            "type": "string",
            "format": "uuid"
          },
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "displayName": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "platform"
    },
    {
      "name": "animals"
    },
    {
      "name": "movements"
    }
  ]
}