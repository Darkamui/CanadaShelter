# Local development settings. DEV-ONLY values — never reuse them anywhere shared.
# Nothing here is required: every value below is also the built-in default.
#
# Docker Compose: to override, copy to .env and pass it explicitly:
#   docker compose --env-file .env -f infrastructure/docker/compose.yml up -d
# Backend: settings are read from environment variables (ASP.NET Core "__" syntax)
#   or backend/Shelter.Host/appsettings.Development.json.

# --- PostgreSQL (infrastructure/docker/compose.yml) ---------------------------
# Host port 55432 avoids clashing with other local Postgres instances on 5432.
POSTGRES_PORT=55432
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=postgres_dev
SHELTER_DB=shelter
# shelter_migrator: owns the schema, runs migrations (scripts/db-migrate-local.sh).
SHELTER_MIGRATOR_PASSWORD=shelter_migrator_dev
# shelter_app: runtime role used by the API. No BYPASSRLS, owns no tables.
SHELTER_APP_PASSWORD=shelter_app_dev
# shelter_platform_admin: cross-tenant provisioning only, via an explicit RLS policy (no BYPASSRLS).
SHELTER_PLATFORM_ADMIN_PASSWORD=shelter_platform_admin_dev

# --- MinIO (S3-compatible object storage) -------------------------------------
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=shelter
MINIO_ROOT_PASSWORD=shelter_minio_dev
MINIO_BUCKET=shelter-local

# --- Mailpit (captures all outgoing email; UI on MAILPIT_UI_PORT) -------------
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# --- Backend (backend/Shelter.Host) -------------------------------------------
ASPNETCORE_ENVIRONMENT=Development
# API listens on http://localhost:5080 (launchSettings.json); the Vite dev server proxies /api to it.
# Use 127.0.0.1, not localhost: localhost may resolve to ::1 and reach a different local Postgres.
ConnectionStrings__App=Host=127.0.0.1;Port=55432;Database=shelter;Username=shelter_app;Password=shelter_app_dev
# Used only by scripts/db-migrate-local.sh, never by the running API.
ConnectionStrings__Migrator=Host=127.0.0.1;Port=55432;Database=shelter;Username=shelter_migrator;Password=shelter_migrator_dev
# Platform module only (provisioning, cross-tenant reads); role shelter_platform_admin, NOBYPASSRLS.
ConnectionStrings__PlatformAdmin=Host=127.0.0.1;Port=55432;Database=shelter;Username=shelter_platform_admin;Password=shelter_platform_admin_dev

# --- Admin app (apps/admin) ---------------------------------------------------
# Vite dev server: http://localhost:5173
