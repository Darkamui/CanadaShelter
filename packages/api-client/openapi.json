{
  "openapi": "3.1.1",
  "info": {
    "title": "Shelter.Host | v1",
    "version": "1.0.0"
  },
  "paths": {
    "/api/platform/ping": {
      "get": {
        "tags": [
          "platform"
        ],
        "operationId": "GetPlatformPing",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PingResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/platform/session/antiforgery": {
      "get": {
        "tags": [
          "platform"
        ],
        "operationId": "GetPlatformSessionAntiforgery",
        "responses": {
          "204": {
            "description": "No Content"
          }
        }
      }
    },
    "/api/platform/session/login": {
      "post": {
        "tags": [
          "platform"
        ],
        "operationId": "LoginPlatformSession",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/platform/session/logout": {
      "post": {
        "tags": [
          "platform"
        ],
        "operationId": "LogoutPlatformSession",
        "responses": {
          "204": {
            "description": "No Content"
          }
        }
      }
    },
    "/api/platform/session": {
      "get": {
        "tags": [
          "platform"
        ],
        "operationId": "GetPlatformSession",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/animals/species": {
      "get": {
        "tags": [
          "animals"
        ],
        "operationId": "ListAnimalsSpecies",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ReferenceItem"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/movements/intake-reasons": {
      "get": {
        "tags": [
          "movements"
        ],
        "operationId": "ListMovementsIntakeReasons",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ReferenceItem"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "LocalizedText": {
        "required": [
          "fr",
          "en"
        ],
        "type": "object",
        "properties": {
          "fr": {
            "type": "string",
            "description": "fr-CA text."
          },
          "en": {
            "type": "string",
            "description": "en-CA text."
          }
        },
        "description": "A value stored in both supported languages (ADR 0013). Both are required: reference data is always bilingual.\nClients pick the label by UI locale."
      },
      "LoginRequest": {
        "required": [
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "LoginResponse": {
        "required": [
          "status"
        ],
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          }
        }
      },
      "PingResponse": {
        "required": [
          "status"
        ],
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          }
        }
      },
      "ReferenceItem": {
        "required": [
          "code",
          "label"
        ],
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "Stable identifier stored by referencing rows; never shown to users."
          },
          "label": {
            "description": "Label in both languages.",
            "$ref": "#/components/schemas/LocalizedText"
          }
        },
        "description": "One value of a reference list as the API returns it: a stable code and both labels."
      },
      "SessionResponse": {
        "required": [
          "user"
        ],
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/SessionUser"
          }
        }
      },
      "SessionUser": {
        "required": [
          "id",
          "displayName",
          "preferredLanguage",
          "isPlatformOperator",
          "mfaEnabled"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "displayName": {
            "type": "string"
          },
          "preferredLanguage": {
            "type": "string"
          },
          "isPlatformOperator": {
            "type": "boolean"
          },
          "mfaEnabled": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "platform"
    },
    {
      "name": "animals"
    },
    {
      "name": "movements"
    }
  ]
}